{
  "name": "dextree",
  "description": "VS Code-first semantic graph tooling for code intelligence.",
  "private": true,
  "version": "1.16.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "author": {
    "name": "DgtalBug",
    "url": "https://github.com/dgtalbug"
  },
  "homepage": "https://github.com/dgtalbug/dextree#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgtalbug/dextree.git"
  },
  "bugs": {
    "url": "https://github.com/dgtalbug/dextree/issues"
  },
  "keywords": [
    "dextree",
    "code-intelligence",
    "vscode",
    "semantic-graph",
    "duckdb",
    "tree-sitter"
  ],
  "engines": {
    "node": ">=22.0.0",
    "pnpm": "11.1.2"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "prettier --write . && eslint --fix \"packages/**/*.ts\" && prettier --check . && turbo run lint && turbo run test && turbo run typecheck",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "extension:reinstall": "node scripts/reinstall-extension.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "lint:fix": "eslint --fix \"packages/**/*.ts\"",
    "package": "pnpm --filter dextree run package",
    "prepare": "husky",
    "test": "turbo run test",
    "test:coverage": "turbo run build && vitest run --coverage",
    "typecheck": "turbo run typecheck",
    "release:check": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm package"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml}": "prettier --write",
    "packages/**/*.{ts,tsx}": "eslint --fix --max-warnings=0"
  },
  "pnpm": {
    "supportedArchitectures": {
      "os": [
        "darwin",
        "linux",
        "win32"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    },
    "overrides": {
      "qs": "^6.15.2"
    },
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "esbuild",
      "keytar",
      "vue-demi"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "react": "*",
        "react-dom": "*",
        "@types/react": "*"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@jazzer.js/core": "^4.0.0",
    "@nolebase/vitepress-plugin-breadcrumbs": "^2.18.2",
    "@nolebase/vitepress-plugin-git-changelog": "^2.18.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.100.0",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "^4.1.8",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "esbuild": "^0.28.0",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.8.0",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.7",
    "mermaid": "^11.15.0",
    "prettier": "^3.8.3",
    "tsup": "^8.4.0",
    "turbo": "^2.9.16",
    "typescript": "^5.8.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-group-icons": "^1.7.5",
    "vitepress-plugin-llms": "^1.13.1",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.8",
    "vue": "^3.5.35"
  }
}
