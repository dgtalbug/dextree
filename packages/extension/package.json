{
  "name": "dextree",
  "displayName": "Dextree",
  "description": "Index one file into the shared Dextree semantic graph.",
  "publisher": "dgtalbug",
  "version": "0.0.0",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/extension.cjs",
  "preview": true,
  "author": {
    "name": "DgtalBug",
    "url": "https://github.com/dgtalbug"
  },
  "homepage": "https://github.com/dgtalbug/dextree#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgtalbug/dextree.git",
    "directory": "packages/extension"
  },
  "bugs": {
    "url": "https://github.com/dgtalbug/dextree/issues"
  },
  "keywords": [
    "dextree",
    "code-intelligence",
    "vscode",
    "vscode-extension",
    "code-graph",
    "graph-visualization"
  ],
  "categories": [
    "Programming Languages",
    "Visualization",
    "Other"
  ],
  "engines": {
    "node": ">=22.22.1",
    "pnpm": "11.1.2",
    "vscode": "^1.85.0"
  },
  "dependencies": {
    "@sigma/node-border": "^3.0.0",
    "@sigma/node-square": "^3.0.0",
    "dompurify": "^3.4.7",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "graphology-dag": "^0.4.1",
    "graphology-layout": "^0.6.1",
    "graphology-layout-noverlap": "^0.4.2",
    "graphology-shortest-path": "^2.1.0",
    "graphology-traversal": "^0.3.1",
    "graphology-types": "^0.24.8",
    "mermaid": "^11.15.0",
    "sigma": "^3.0.2",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@dextree/core": "workspace:*",
    "@dextree/exporters": "workspace:*",
    "@duckdb/node-api": "^1.5.2-r.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vscode/codicons": "^0.0.45",
    "@vscode/vsce": "^3.4.0",
    "framer-motion": "^12.40.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "vite": "^8.0.16",
    "web-tree-sitter": "^0.26.9"
  },
  "scripts": {
    "build": "node esbuild.mjs && vite build",
    "build:extension": "node esbuild.mjs",
    "build:webview": "vite build",
    "watch:extension": "node esbuild.mjs --watch",
    "watch:webview": "vite build --watch",
    "dev": "node dev.mjs",
    "prepackage": "pnpm build",
    "package": "node scripts/package.mjs",
    "lint": "eslint \"src/**/*.ts\" \"src/**/*.tsx\" --max-warnings=0",
    "test": "vitest run --root ../.. --config vitest.config.ts --project extension --project webview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json"
  },
  "activationEvents": [
    "onCommand:dextree.openGraphView",
    "onView:dextree.symbolsView",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onLanguage:typescriptreact",
    "onLanguage:javascriptreact",
    "onLanguage:python",
    "onLanguage:markdown"
  ],
  "contributes": {
    "commands": [
      {
        "command": "dextree.openGraphView",
        "title": "Dextree: Open Graph View",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "dextree.indexFile",
        "title": "Dextree: Index File"
      },
      {
        "command": "dextree.indexWorkspace",
        "title": "Dextree: Index Workspace",
        "icon": "$(sync)"
      },
      {
        "command": "dextree.clearWorkspaceIndex",
        "title": "Dextree: Clear Workspace Index"
      },
      {
        "command": "dextree.clearAllIndex",
        "title": "Dextree: Clear All Indexed Data"
      },
      {
        "command": "dextree.cancelWorkspaceIndexing",
        "title": "Dextree: Cancel Workspace Indexing",
        "icon": "$(stop-circle)",
        "enablement": "dextree.isIndexing"
      },
      {
        "command": "dextree.exportMermaid",
        "title": "Dextree: Export as Mermaid"
      },
      {
        "command": "dextree.exportSessionSummary",
        "title": "Dextree: Export Session Summary"
      },
      {
        "command": "dextree.switchWorkspace",
        "title": "Dextree: Switch Workspace"
      },
      {
        "command": "dextree.exportCallers",
        "title": "Dextree: Export Callers as Mermaid"
      },
      {
        "command": "dextree.exportCallees",
        "title": "Dextree: Export Callees as Mermaid"
      },
      {
        "command": "dextree.exportClassHierarchy",
        "title": "Dextree: Export Class Hierarchy as Mermaid"
      },
      {
        "command": "dextree.exportPackage",
        "title": "Dextree: Export Package as Mermaid"
      },
      {
        "command": "dextree.exportTrace",
        "title": "Dextree: Export Trace as Mermaid"
      },
      {
        "command": "dextree.exportCurrentView",
        "title": "Dextree: Export Current View as Mermaid"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dextree.indexWorkspace",
          "when": "view == dextree.symbolsView",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "dextree.exportMermaid",
          "when": "view == dextree.symbolsView && viewItem == dextreeSymbol",
          "group": "dextree@1"
        },
        {
          "command": "dextree.exportMermaid",
          "when": "view == dextree.symbolsView && viewItem == dextreeFile",
          "group": "dextree@1"
        },
        {
          "command": "dextree.exportPackage",
          "when": "view == dextree.symbolsView && viewItem == dextreeFile",
          "group": "dextree@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dextree",
          "title": "Dextree",
          "icon": "resources/dextree.svg"
        }
      ]
    },
    "views": {
      "dextree": [
        {
          "id": "dextree.symbolsView",
          "name": "Symbols"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "dextree.symbolsView",
        "contents": "No symbols indexed yet.\n\n[$(sync) Index Workspace](command:dextree.indexWorkspace)\n\nOr run [Dextree: Index File](command:dextree.indexFile) on a single open file, or open the graph later from the Command Palette with [Dextree: Open Graph View](command:dextree.openGraphView)."
      }
    ],
    "configuration": {
      "title": "Dextree",
      "properties": {
        "dextree.watcher.verbose": {
          "type": "boolean",
          "default": false,
          "description": "Log skipped (unchanged) file events to the Dextree output channel."
        },
        "dextree.exporters.theme": {
          "type": "string",
          "enum": [
            "Light",
            "Dark",
            "Print"
          ],
          "default": "Light",
          "description": "Theme applied when exporting a Mermaid diagram.",
          "scope": "resource"
        },
        "dextree.exporters.includeClickLinks": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, exported .svg diagrams include click-through links back to source code. Mermaid .mmd source exports are link-free by default regardless of this setting.",
          "scope": "resource"
        }
      }
    }
  }
}
