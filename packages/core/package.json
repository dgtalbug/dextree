{
  "name": "@dextree/core",
  "description": "Shared parser, storage, and query engine for Dextree.",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "DgtalBug",
    "url": "https://github.com/dgtalbug"
  },
  "homepage": "https://github.com/dgtalbug/dextree#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgtalbug/dextree.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/dgtalbug/dextree/issues"
  },
  "keywords": [
    "dextree",
    "code-intelligence",
    "vscode",
    "graph",
    "ast",
    "tree-sitter",
    "duckdb"
  ],
  "engines": {
    "node": ">=22.22.1",
    "pnpm": "11.1.2"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lenses": {
      "types": "./dist/query/lenses.d.ts",
      "import": "./dist/query/lenses.js",
      "require": "./dist/query/lenses.cjs"
    }
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "gen:tags": "node scripts/gen-tags-providers.mjs",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "test": "vitest run --root ../.. --config vitest.config.ts --project core",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@duckdb/node-api": "^1.5.2-r.2",
    "graphology": "^0.26.0",
    "graphology-components": "^1.5.4",
    "graphology-metrics": "^2.4.0",
    "ignore": "^7.0.5",
    "picomatch": "^4.0.5",
    "tree-sitter-c": "0.24.1",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-cpp": "0.23.4",
    "tree-sitter-elixir": "0.3.5",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-java": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-php": "0.24.2",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "tree-sitter-scala": "0.24.0",
    "tree-sitter-typescript": "^0.23.2",
    "uuid": "^14.0.1",
    "web-tree-sitter": "^0.26.10"
  },
  "devDependencies": {
    "@types/picomatch": "^4.0.0"
  }
}
